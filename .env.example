# Copy this file to .env and provide local development values.
# Never commit the corresponding .env file.

# Select one provider for every LLM call in the run: openai or deepseek.
LLM_PROVIDER=

# OPENAI - Required only when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL_NAME=

# DEEPSEEK - Required only when LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL_NAME=

# TAVILY
TAVILY_API_KEY=
